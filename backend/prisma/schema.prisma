  maintainer       User            @relation(fields: [performed_by], references: [id])

  @@index([equipment_id, performed_at])
  @@map("maintenance_logs")
}

model MaintenanceSchedule {
  id                String                  @id @default(uuid())
  tenant_id         String
  branch_id         String
  name              String
  trigger_type      String
  gallon_interval   Int?
  day_interval      Int?
  next_due_at       DateTime?               @db.Timestamp(6)
  baseline_gallons  Int                     @default(0)
  last_completed_at DateTime?               @db.Timestamp(6)
  notes             String?
  is_active         Boolean                 @default(true)
  created_by        String
  created_at        DateTime                @default(now()) @db.Timestamp(6)
  updated_at        DateTime                @default(now()) @db.Timestamp(6)
  completions       MaintenanceCompletion[]
  tenant            Tenant                  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  branch            Branch                  @relation(fields: [branch_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, branch_id, is_active])
  @@map("maintenance_schedules")
}

model MaintenanceCompletion {
  id                         String              @id @default(uuid())
  tenant_id                  String
  schedule_id                String
  performed_by               String
  performed_at               DateTime            @default(now()) @db.Timestamp(6)
  gallon_count_at_completion Int
  notes                      String?
  created_at                 DateTime            @default(now()) @db.Timestamp(6)
  schedule                   MaintenanceSchedule @relation(fields: [schedule_id], references: [id], onDelete: Cascade)
  tenant                     Tenant              @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([schedule_id, performed_at])
  @@map("maintenance_completions")
}

model Notification {
  id            String              @id @default(uuid())
  tenant_id     String
  user_id       String?
  customer_id   String?
  channel       NotificationChannel
  template_code String?
  payload       Json
  status        NotificationStatus  @default(QUEUED)
  retry_count   Int                 @default(0)
  max_retries   Int                 @default(3)
  sent_at       DateTime?           @db.Timestamp(6)
  failed_at     DateTime?           @db.Timestamp(6)
  error_message String?
  created_at    DateTime            @default(now()) @db.Timestamp(6)
  deleted_at    DateTime?           @db.Timestamp(6)
  tenant        Tenant              @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, status, created_at])
  @@map("notifications")
}

model NotificationTemplate {
  id            String              @id @default(uuid())
  tenant_id     String
  code          String
  channel       NotificationChannel
  subject       String?
  body_template String
  variables     Json?
  is_active     Boolean             @default(true)
  created_at    DateTime            @default(now()) @db.Timestamp(6)
  updated_at    DateTime            @default(now()) @db.Timestamp(6)
  deleted_at    DateTime?           @db.Timestamp(6)

  @@unique([tenant_id, code, channel])
  @@map("notification_templates")
}

model NotificationPreference {
  id            String              @id @default(uuid())
  tenant_id     String
  user_id       String?
  customer_id   String?
  channel       NotificationChannel
  template_code String
  is_enabled    Boolean             @default(true)
  created_at    DateTime            @default(now()) @db.Timestamp(6)
  updated_at    DateTime            @default(now()) @db.Timestamp(6)
  deleted_at    DateTime?           @db.Timestamp(6)

  @@unique([user_id, customer_id, template_code, channel])
  @@index([tenant_id])
  @@map("notification_preferences")
}

model ReportSchedule {
  id          String    @id @default(uuid())
  tenant_id   String
  report_type String
  frequency   String
  recipients  Json
  format      String    @default("pdf")
  filters     Json?
  is_active   Boolean   @default(true)
  last_run_at DateTime? @db.Timestamp(6)
  next_run_at DateTime? @db.Timestamp(6)
  created_at  DateTime  @default(now()) @db.Timestamp(6)
  updated_at  DateTime  @default(now()) @db.Timestamp(6)
  deleted_at  DateTime? @db.Timestamp(6)
  created_by  String?

  @@index([tenant_id, is_active])
  @@map("report_schedules")
}

model ExportJob {
  id            String    @id @default(uuid())
  tenant_id     String
  report_type   String
  format        String
  filters       Json
  file_url      String?
  status        String    @default("pending")
  started_at    DateTime? @db.Timestamp(6)
  completed_at  DateTime? @db.Timestamp(6)
  error_message String?
  requested_by  String
  created_at    DateTime  @default(now()) @db.Timestamp(6)
  deleted_at    DateTime? @db.Timestamp(6)

  @@index([tenant_id, status])
  @@map("export_jobs")
}

