generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                        String                   @id @default(uuid())
  name                      String
  subscription_plan         String?
  subscription_status       String?
  is_active                 Boolean                  @default(true)
  created_at                DateTime                 @default(now()) @db.Timestamp(6)
  updated_at                DateTime                 @default(now()) @db.Timestamp(6)
  deleted_at                DateTime?                @db.Timestamp(6)
  created_by                String?
  audit_logs                AuditLog[]
  backups                   Backup[]
  branch_inventories        BranchInventory[]
  branches                  Branch[]
  customers                 Customer[]
  delivery_orders           DeliveryOrder[]
  integrations              Integration[]
  maintenance_schedules     MaintenanceSchedule[]
  maintenance_completions   MaintenanceCompletion[]
  inventory_ledgers         InventoryLedger[]
  inventory_update_requests InventoryUpdateRequest[]
  inventory_loans           InventoryLoan[]
  notifications             Notification[]
  permissions               Permission[]
  product_categories        ProductCategory[]
  products                  Product[]
  roles                     Role[]
  sales_transactions        SalesTransaction[]
  settings                  Setting[]
  users                     User[]

  @@map("tenants")
}

model Branch {
  id                        String                   @id @default(uuid())
  tenant_id                 String
  name                      String
  address                   String?
  contact_number            String?
  email                     String?
  tin                       String?
  is_hq                     Boolean                  @default(false)
  is_active                 Boolean                  @default(true)
  business_hours            Json?
  created_at                DateTime                 @default(now()) @db.Timestamp(6)
  updated_at                DateTime                 @default(now()) @db.Timestamp(6)
  deleted_at                DateTime?                @db.Timestamp(6)
  created_by                String?
  branch_inventories        BranchInventory[]
  tenant                    Tenant                   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  container_movements       ContainerMovement[]
  customer_ledgers          CustomerLedger[]
  customers                 Customer[]
  delivery_orders           DeliveryOrder[]
  delivery_routes           DeliveryRoute[]
  equipment                 Equipment[]
  gallons                   Gallon[]
  installment_plans         InstallmentPlan[]
  inventory_ledgers         InventoryLedger[]
  inventory_update_requests InventoryUpdateRequest[]
  inventory_loans           InventoryLoan[]
  maintenance_schedules     MaintenanceSchedule[]
  production_batches        ProductionBatch[]
  rider_shifts              RiderShift[]
  sales_transactions        SalesTransaction[]
  settings                  Setting[]
  shifts                    Shift[]
  stock_count_sessions      StockCountSession[]
  stock_transfers_dest      StockTransfer[]          @relation("StockTransferDestination")
  stock_transfers_origin    StockTransfer[]          @relation("StockTransferOrigin")
  user_role_assignments     UserRoleAssignment[]
  users                     User[]

  @@map("branches")
}

model User {
  id                  String                 @id @default(uuid())
  tenant_id           String
  branch_id           String?
  full_name           String
  email               String                 @unique
  phone               String?
  password_hash       String
  pin_hash            String?
  status              String                 @default("active")
  last_login_at       DateTime?              @db.Timestamp(6)
  created_at          DateTime               @default(now()) @db.Timestamp(6)
  updated_at          DateTime               @default(now()) @db.Timestamp(6)
  deleted_at          DateTime?              @db.Timestamp(6)
  created_by          String?
  audit_logs          AuditLog[]
  container_movements ContainerMovement[]    @relation("ContainerMovementUser")
  delivery_orders     DeliveryOrder[]        @relation("AssignedRider")
  delivery_routes     DeliveryRoute[]
  gallon_cleanings    GallonCleaningRecord[]
  gallon_fill_logs    GallonFillLog[]
  gallon_inspections  GallonInspection[]
  maintenance_logs    MaintenanceLog[]
  payments            Payment[]              @relation("PaymentCollectedBy")
  production_batches  ProductionBatch[]
  refresh_tokens      RefreshToken[]
  rider_shifts        RiderShift[]
  sales_transactions  SalesTransaction[]     @relation("SalesTransactionUser")
  inventory_loans     InventoryLoan[]        @relation("InventoryLoanCreatedBy")
  shifts              Shift[]
  user_roles          UserRoleAssignment[]
  branch              Branch?                @relation(fields: [branch_id], references: [id])
  tenant              Tenant                 @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, branch_id])
  @@index([email])
  @@map("users")
}

model Role {
  id               String               @id @default(uuid())
  tenant_id        String
  code             String
  name             String
  description      String?
  is_system        Boolean              @default(false)
  is_active        Boolean              @default(true)
  created_at       DateTime             @default(now()) @db.Timestamp(6)
  updated_at       DateTime             @default(now()) @db.Timestamp(6)
  deleted_at       DateTime?            @db.Timestamp(6)
  role_permissions RolePermission[]
  tenant           Tenant               @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user_roles       UserRoleAssignment[]

  @@unique([tenant_id, code])
  @@map("roles")
}

model Permission {
  id               String           @id @default(uuid())
  tenant_id        String
  module           String
  action           String
  code             String           @unique
  description      String?
  created_at       DateTime         @default(now()) @db.Timestamp(6)
  deleted_at       DateTime?        @db.Timestamp(6)
  tenant           Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  role_permissions RolePermission[]

  @@map("permissions")
}

model UserRoleAssignment {
  id          String    @id @default(uuid())
  tenant_id   String
  user_id     String
  role_id     String
  branch_id   String?
  is_active   Boolean   @default(true)
  assigned_at DateTime  @default(now()) @db.Timestamp(6)
  deleted_at  DateTime? @db.Timestamp(6)
  assigned_by String?
  branch      Branch?   @relation(fields: [branch_id], references: [id])
  role        Role      @relation(fields: [role_id], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, role_id, branch_id])
  @@index([tenant_id])
  @@map("user_roles")
}

model RolePermission {
  id            String     @id @default(uuid())
  tenant_id     String
  role_id       String
  permission_id String
  created_at    DateTime   @default(now()) @db.Timestamp(6)
  deleted_at    DateTime?  @db.Timestamp(6)
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)
  role          Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([role_id, permission_id])
  @@index([tenant_id])
  @@map("role_permissions")
}

model RefreshToken {
  id         String    @id @default(uuid())
  tenant_id  String
  user_id    String
  token      String    @unique
  expires_at DateTime  @db.Timestamp(6)
  revoked    Boolean   @default(false)
  created_at DateTime  @default(now()) @db.Timestamp(6)
  deleted_at DateTime? @db.Timestamp(6)
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@map("refresh_tokens")
}

model AuditLog {
  id          String    @id @default(uuid())
  tenant_id   String
  user_id     String?
  action      String
  entity_type String
  entity_id   String
  before_data Json?
  after_data  Json?
  ip_address  String?
  user_agent  String?
  created_at  DateTime  @default(now()) @db.Timestamp(6)
  deleted_at  DateTime? @db.Timestamp(6)
  tenant      Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [user_id], references: [id])

  @@index([tenant_id, entity_type, entity_id])
  @@index([created_at])
  @@map("audit_logs")
}

model Setting {
  id          String    @id @default(uuid())
  tenant_id   String
  branch_id   String?
  key         String
  value       Json
  description String?
  updated_at  DateTime  @default(now()) @db.Timestamp(6)
  deleted_at  DateTime? @db.Timestamp(6)
  updated_by  String?
  branch      Branch?   @relation(fields: [branch_id], references: [id])
  tenant      Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, branch_id, key])
  @@map("settings")
}

model Backup {
  id            String    @id @default(uuid())
  tenant_id     String
  file_path     String?
  file_url      String?
  size_bytes    BigInt?
  status        String
  triggered_by  String
  started_at    DateTime  @db.Timestamp(6)
  completed_at  DateTime? @db.Timestamp(6)
  error_message String?
  created_at    DateTime  @default(now()) @db.Timestamp(6)
  deleted_at    DateTime? @db.Timestamp(6)
  tenant        Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@map("backups")
}

model Integration {
  id               String    @id @default(uuid())
  tenant_id        String
  provider         String
  name             String
  config           Json
  status           String    @default("active")
  last_test_at     DateTime? @db.Timestamp(6)
  last_test_status String?
  created_at       DateTime  @default(now()) @db.Timestamp(6)
  updated_at       DateTime  @default(now()) @db.Timestamp(6)
  deleted_at       DateTime? @db.Timestamp(6)
  tenant           Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  webhooks         Webhook[]

  @@unique([tenant_id, provider])
  @@map("integrations")
}

model Webhook {
  id             String      @id @default(uuid())
  integration_id String
  event          String
  url            String
  secret         String?
  is_active      Boolean     @default(true)
  created_at     DateTime    @default(now()) @db.Timestamp(6)
  deleted_at     DateTime?   @db.Timestamp(6)
  integration    Integration @relation(fields: [integration_id], references: [id], onDelete: Cascade)

  @@map("webhooks")
}

model FeatureFlag {
  id          String    @id @default(uuid())
  tenant_id   String
  key         String
  is_enabled  Boolean   @default(false)
  description String?
  updated_at  DateTime  @default(now()) @db.Timestamp(6)
  deleted_at  DateTime? @db.Timestamp(6)
  updated_by  String?

  @@unique([tenant_id, key])
  @@map("feature_flags")
}

model ProductCategory {
  id          String            @id @default(uuid())
  tenant_id   String
  name        String
  description String?
  parent_id   String?
  is_active   Boolean           @default(true)
  created_at  DateTime          @default(now()) @db.Timestamp(6)
  updated_at  DateTime          @default(now()) @db.Timestamp(6)
  deleted_at  DateTime?         @db.Timestamp(6)
  parent      ProductCategory?  @relation("CategoryHierarchy", fields: [parent_id], references: [id])
  children    ProductCategory[] @relation("CategoryHierarchy")
  tenant      Tenant            @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  products    Product[]

  @@index([tenant_id])
  @@map("product_categories")
}

model Product {
  id                                    String                              @id @default(uuid())
  tenant_id                             String
  category_id                           String
  sku                                   String
  name                                  String
  description                           String?
  type                                  ProductType
  unit_of_measure                       String
  base_price                            Decimal                             @db.Decimal(12, 2)
  cost_price                            Decimal                             @db.Decimal(12, 2)
  is_container                          Boolean                             @default(false)
  deposit_amount                        Decimal?                            @db.Decimal(12, 2)
  reorder_level                         Int                                 @default(0)
  is_active                             Boolean                             @default(true)
  is_stock_tracked                      Boolean                             @default(true)
  is_for_sale                           Boolean                             @default(true)
  created_at                            DateTime                            @default(now()) @db.Timestamp(6)
  updated_at                            DateTime                            @default(now()) @db.Timestamp(6)
  deleted_at                            DateTime?                           @db.Timestamp(6)
  created_by                            String?
  branch_inventories                    BranchInventory[]
  container_deposits                    ContainerDeposit[]
  customer_container_balances           CustomerContainerBalance[]
  delivery_order_items                  DeliveryOrderItem[]
  gallon_types                          GallonType[]
  inventory_ledgers                     InventoryLedger[]
  inventory_update_requests             InventoryUpdateRequest[]
  production_batches                    ProductionBatch[]                   @relation("ProductionOutput")
  category                              ProductCategory                     @relation(fields: [category_id], references: [id])
  tenant                                Tenant                              @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  purchase_items                        PurchaseItem[]
  reseller_consignments                 ResellerConsignment[]
  sales_transaction_container_exchanges SalesTransactionContainerExchange[]
  sales_transaction_items               SalesTransactionItem[]
  standing_order_items                  StandingOrderItem[]
  stock_count_items                     StockCountItem[]
  stock_transfer_items                  StockTransferItem[]
  inventory_loans                       InventoryLoan[]

  @@unique([tenant_id, sku])
  @@index([category_id])
  @@index([type])
  @@map("products")
}

model BranchInventory {
  id                String    @id @default(uuid())
  tenant_id         String
  branch_id         String
  product_id        String
  quantity_on_hand  Int       @default(0)
  reserved_quantity Int       @default(0)
  last_counted_at   DateTime? @db.Timestamp(6)
  created_at        DateTime  @default(now()) @db.Timestamp(6)
  updated_at        DateTime  @default(now()) @db.Timestamp(6)
  deleted_at        DateTime? @db.Timestamp(6)
  branch            Branch    @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  product           Product   @relation(fields: [product_id], references: [id], onDelete: Cascade)
  tenant            Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([branch_id, product_id])
  @@index([tenant_id])
  @@map("branch_inventory")
}

enum InventoryLoanStatus {
  OUTSTANDING
  RETURNED
  SOLD
}

model InventoryLoan {
  id          String              @id @default(uuid())
  tenant_id   String
  branch_id   String
  product_id  String
  customer_id String
  sale_id     String?
  quantity    Int
  status      InventoryLoanStatus @default(OUTSTANDING)
  notes       String?
  lent_at     DateTime            @default(now()) @db.Timestamp(6)
  resolved_at DateTime?           @db.Timestamp(6)
  created_by  String
  created_at  DateTime            @default(now()) @db.Timestamp(6)
  updated_at  DateTime            @default(now()) @db.Timestamp(6)
  tenant      Tenant              @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  branch      Branch              @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  product     Product             @relation(fields: [product_id], references: [id])
  customer    Customer            @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  creator     User                @relation("InventoryLoanCreatedBy", fields: [created_by], references: [id])

  @@index([tenant_id, branch_id, status])
  @@index([customer_id, status])
  @@index([product_id, status])
  @@map("inventory_loans")
}

model InventoryLedger {
  id             String       @id @default(uuid())
  tenant_id      String
  branch_id      String
  product_id     String
  movement_type  MovementType
  quantity_delta Int
  reference_type String?
  reference_id   String?
  notes          String?
  created_at     DateTime     @default(now()) @db.Timestamp(6)
  deleted_at     DateTime?    @db.Timestamp(6)
  created_by     String?
  branch         Branch       @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [product_id], references: [id], onDelete: Cascade)
  tenant         Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, branch_id, product_id])
  @@index([created_at])
  @@map("inventory_ledger")
}

model InventoryUpdateRequest {
  id                 String                       @id @default(uuid())
  tenant_id          String
  branch_id          String
  product_id         String
  requested_by       String
  approved_by        String?
  previous_quantity  Int
  requested_quantity Int
  approved_quantity  Int?
  notes              String?
  status             InventoryUpdateRequestStatus @default(PENDING)
  reviewed_at        DateTime?                    @db.Timestamp(6)
  created_at         DateTime                     @default(now()) @db.Timestamp(6)
  updated_at         DateTime                     @default(now()) @db.Timestamp(6)
  deleted_at         DateTime?                    @db.Timestamp(6)

  branch  Branch  @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, branch_id, product_id])
  @@index([status])
  @@map("inventory_update_requests")
}

model GallonType {
  id              String    @id @default(uuid())
  tenant_id       String
  product_id      String
  name            String
  description     String?
  capacity_liters Decimal?  @db.Decimal(6, 2)
  material        String?
  color           String?
  is_active       Boolean   @default(true)
  created_at      DateTime  @default(now()) @db.Timestamp(6)
  updated_at      DateTime  @default(now()) @db.Timestamp(6)
  deleted_at      DateTime? @db.Timestamp(6)
  product         Product   @relation(fields: [product_id], references: [id])
  gallons         Gallon[]

  @@unique([tenant_id, product_id])
  @@map("gallon_types")
}

model Gallon {
  id                          String                              @id @default(uuid())
  tenant_id                   String
  branch_id                   String
  gallon_type_id              String
  tag_code                    String                              @unique
  serial_number               String?                             @unique
  status                      ContainerStatus                     @default(IN_STOCK)
  current_holder_type         String?
  current_holder_id           String?
  current_condition           String?
  purchase_date               DateTime?                           @db.Timestamp(6)
  purchase_price              Decimal?                            @db.Decimal(10, 2)
  last_cleaned_at             DateTime?                           @db.Timestamp(6)
  last_inspected_at           DateTime?                           @db.Timestamp(6)
  last_filled_at              DateTime?                           @db.Timestamp(6)
  total_fill_count            Int                                 @default(0)
  total_cleanings             Int                                 @default(0)
  is_active                   Boolean                             @default(true)
  created_at                  DateTime                            @default(now()) @db.Timestamp(6)
  updated_at                  DateTime                            @default(now()) @db.Timestamp(6)
  deleted_at                  DateTime?                           @db.Timestamp(6)
  container_deposits          ContainerDeposit[]
  container_movements         ContainerMovement[]
  cleaning_records            GallonCleaningRecord[]
  fill_logs                   GallonFillLog[]
  inspections                 GallonInspection[]
  status_history              GallonStatusHistory[]
  branch                      Branch                              @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  gallon_type                 GallonType                          @relation(fields: [gallon_type_id], references: [id])
  sales_transaction_exchanges SalesTransactionContainerExchange[]

  @@index([tenant_id, branch_id])
  @@index([status])
  @@index([tag_code])
  @@map("gallons")
}

model GallonStatusHistory {
  id         String          @id @default(uuid())
  tenant_id  String
  gallon_id  String
  status     ContainerStatus
  reason     String?
  changed_by String?
  changed_at DateTime        @default(now()) @db.Timestamp(6)
  deleted_at DateTime?       @db.Timestamp(6)
  notes      String?
  gallon     Gallon          @relation(fields: [gallon_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([gallon_id, changed_at])
  @@map("gallon_status_history")
}

model GallonCleaningRecord {
  id              String    @id @default(uuid())
  gallon_id       String
  branch_id       String
  cleaned_by      String
  cleaning_type   String
  used_detergents Json?
  ph_level        Decimal?  @db.Decimal(4, 2)
  is_passed       Boolean   @default(true)
  notes           String?
  cleaned_at      DateTime  @default(now()) @db.Timestamp(6)
  deleted_at      DateTime? @db.Timestamp(6)
  cleaner         User      @relation(fields: [cleaned_by], references: [id])
  gallon          Gallon    @relation(fields: [gallon_id], references: [id], onDelete: Cascade)

  @@index([gallon_id, cleaned_at])
  @@map("gallon_cleaning_records")
}

model GallonInspection {
  id            String    @id @default(uuid())
  tenant_id     String
  gallon_id     String
  branch_id     String
  inspected_by  String
  condition     String
  has_cracks    Boolean   @default(false)
  has_stains    Boolean   @default(false)
  is_odor_free  Boolean   @default(true)
  seal_intact   Boolean   @default(true)
  overall_grade String?
  notes         String?
  passed        Boolean   @default(true)
  inspected_at  DateTime  @default(now()) @db.Timestamp(6)
  deleted_at    DateTime? @db.Timestamp(6)
  gallon        Gallon    @relation(fields: [gallon_id], references: [id], onDelete: Cascade)
  inspector     User      @relation(fields: [inspected_by], references: [id])

  @@index([tenant_id])
  @@index([gallon_id, inspected_at])
  @@map("gallon_inspections")
}

model GallonFillLog {
  id                   String    @id @default(uuid())
  tenant_id            String
  gallon_id            String
  branch_id            String
  production_batch_id  String?
  filled_by            String
  fill_volume_liters   Decimal   @db.Decimal(6, 2)
  water_source         String?
  purification_stages  Json?
  quality_check_passed Boolean   @default(true)
  ph_level             Decimal?  @db.Decimal(4, 2)
  tds_level            Decimal?  @db.Decimal(6, 2)
  filled_at            DateTime  @default(now()) @db.Timestamp(6)
  deleted_at           DateTime? @db.Timestamp(6)
  fill_operator        User      @relation(fields: [filled_by], references: [id])
  gallon               Gallon    @relation(fields: [gallon_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([gallon_id, filled_at])
  @@map("gallon_fill_logs")
}

model ProductionBatch {
  id                   String    @id @default(uuid())
  tenant_id            String
  branch_id            String
  batch_number         String
  raw_input_liters     Decimal?  @db.Decimal(10, 2)
  output_product_id    String
  output_quantity      Int
  operator_id          String
  quality_check_passed Boolean   @default(false)
  quality_notes        String?
  started_at           DateTime  @db.Timestamp(6)
  completed_at         DateTime? @db.Timestamp(6)
  created_at           DateTime  @default(now()) @db.Timestamp(6)
  updated_at           DateTime  @default(now()) @db.Timestamp(6)
  deleted_at           DateTime? @db.Timestamp(6)
  branch               Branch    @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  operator             User      @relation(fields: [operator_id], references: [id])
  output_product       Product   @relation("ProductionOutput", fields: [output_product_id], references: [id])

  @@unique([tenant_id, batch_number])
  @@index([branch_id, completed_at])
  @@map("production_batches")
}

model Supplier {
  id             String     @id @default(uuid())
  tenant_id      String
  name           String
  contact_person String?
  email          String?
  phone          String?
  address        String?
  tin            String?
  is_active      Boolean    @default(true)
  created_at     DateTime   @default(now()) @db.Timestamp(6)
  updated_at     DateTime   @default(now()) @db.Timestamp(6)
  deleted_at     DateTime?  @db.Timestamp(6)
  purchases      Purchase[]

  @@index([tenant_id])
  @@map("suppliers")
}

model Purchase {
  id               String         @id @default(uuid())
  tenant_id        String
  supplier_id      String
  branch_id        String
  purchase_date    DateTime       @db.Timestamp(6)
  reference_number String?
  total_amount     Decimal        @db.Decimal(12, 2)
  status           String         @default("pending")
  received_at      DateTime?      @db.Timestamp(6)
  received_by      String?
  notes            String?
  created_at       DateTime       @default(now()) @db.Timestamp(6)
  updated_at       DateTime       @default(now()) @db.Timestamp(6)
  deleted_at       DateTime?      @db.Timestamp(6)
  created_by       String?
  items            PurchaseItem[]
  supplier         Supplier       @relation(fields: [supplier_id], references: [id])

  @@index([tenant_id, supplier_id])
  @@index([purchase_date])
  @@map("purchases")
}

model PurchaseItem {
  id          String    @id @default(uuid())
  purchase_id String
  product_id  String
  quantity    Int
  unit_cost   Decimal   @db.Decimal(12, 2)
  line_total  Decimal   @db.Decimal(12, 2)
