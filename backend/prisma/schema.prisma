  created_at   DateTime  @default(now()) @db.Timestamp(6)
  deleted_at   DateTime? @db.Timestamp(6)
  created_by   String?

  @@index([tenant_id, branch_id, expense_date])
  @@map("expenses")
}

model BankStatement {
  id                     String                @id @default(uuid())
  tenant_id              String
  bank_name              String
  account_number         String?
  statement_date         DateTime              @db.Timestamp(6)
  opening_balance        Decimal               @db.Decimal(12, 2)
  closing_balance        Decimal               @db.Decimal(12, 2)
  total_credits          Decimal               @db.Decimal(12, 2)
  total_debits           Decimal               @db.Decimal(12, 2)
  file_url               String?
  import_status          String                @default("imported")
  created_at             DateTime              @default(now()) @db.Timestamp(6)
  deleted_at             DateTime?             @db.Timestamp(6)
  imported_by            String?
  reconciliation_entries ReconciliationEntry[]

  @@index([tenant_id, statement_date])
  @@map("bank_statements")
}

model ReconciliationEntry {
  id                String               @id @default(uuid())
  tenant_id         String
  bank_statement_id String
  payment_id        String?
  system_amount     Decimal              @db.Decimal(12, 2)
  statement_amount  Decimal              @db.Decimal(12, 2)
  difference_amount Decimal              @db.Decimal(12, 2)
  status            ReconciliationStatus @default(UNRECONCILED)
  matched_at        DateTime?            @db.Timestamp(6)
  notes             String?
  created_at        DateTime             @default(now()) @db.Timestamp(6)
  deleted_at        DateTime?            @db.Timestamp(6)
  bank_statement    BankStatement        @relation(fields: [bank_statement_id], references: [id], onDelete: Cascade)
  payment           Payment?             @relation(fields: [payment_id], references: [id])

  @@index([bank_statement_id, status])
  @@map("reconciliation_entries")
}

model ContainerMovement {
  id               String       @id @default(uuid())
  tenant_id        String
  gallon_id        String
