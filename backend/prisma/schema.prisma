  tenant_id           String
  customer_id         String
  product_id          String
  gallon_id           String?
  quantity            Int
  unit_deposit_amount Decimal   @db.Decimal(12, 2)
  total_amount        Decimal   @db.Decimal(12, 2)
  status              String    @default("held")
  refund_amount       Decimal?  @db.Decimal(12, 2)
  refunded_at         DateTime? @db.Timestamp(6)
  refunded_by         String?
  created_at          DateTime  @default(now()) @db.Timestamp(6)
  updated_at          DateTime  @default(now()) @db.Timestamp(6)
  deleted_at          DateTime? @db.Timestamp(6)
  customer            Customer  @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  gallon              Gallon?   @relation(fields: [gallon_id], references: [id])
  product             Product   @relation(fields: [product_id], references: [id])

  @@index([customer_id, status])
  @@map("container_deposits")
}

model Refund {
  id               String        @id @default(uuid())
  tenant_id        String
  customer_id      String
  refund_type      String
  amount           Decimal       @db.Decimal(12, 2)
  payment_method   PaymentMethod
  reference_number String?
  reason           String?
  approved_by      String?
  refunded_at      DateTime      @db.Timestamp(6)
  created_at       DateTime      @default(now()) @db.Timestamp(6)
  deleted_at       DateTime?     @db.Timestamp(6)
  created_by       String?
  customer         Customer      @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, customer_id])
  @@map("refunds")
}

model CashTransaction {
  id               String    @id @default(uuid())
  tenant_id        String
  branch_id        String
  transaction_type String
  amount           Decimal   @db.Decimal(12, 2)
  reference_type   String?
  reference_id     String?
  notes            String?
  recorded_by      String
  recorded_at      DateTime  @default(now()) @db.Timestamp(6)
  deleted_at       DateTime? @db.Timestamp(6)

  @@index([tenant_id, branch_id, recorded_at])
  @@map("cash_transactions")
}

model Expense {
  id           String    @id @default(uuid())
  tenant_id    String
  branch_id    String
