  from_holder_type String?
  from_holder_id   String?
  to_holder_type   String?
  to_holder_id     String?
  reference_type   String?
  reference_id     String?
  changed_by       String?
  notes            String?
  created_at       DateTime     @default(now()) @db.Timestamp(6)
  deleted_at       DateTime?    @db.Timestamp(6)
